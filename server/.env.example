# ==============================================
# Server Environment Variables
# ==============================================
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL / MongoDB / MySQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fullstack_db

# Authentication & Security
JWT_SECRET=supersecret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# CORS Allowed Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

# Multi-Agent Travel Planner AI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
AI_REQUEST_TIMEOUT_MS=15000
